PLANE_BASE_URL=http://host.docker.internal:8000
PLANE_WORKSPACE_SLUG=your-workspace
PLANE_API_KEY=replace-with-plane-api-token
PLANE_MCP_HTTP_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
PLANE_MCP_READ_ONLY=false
# Set per_user for HTTP callers to authenticate with their own Plane API token.
# In this mode PLANE_API_KEY and PLANE_MCP_HTTP_TOKEN are unused.
PLANE_MCP_AUTH_MODE=shared
